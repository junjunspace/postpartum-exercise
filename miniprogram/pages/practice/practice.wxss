/* pages/practice/practice.wxss */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--dark-bg);
}

/* 顶部导航 */
.p-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  height: 112rpx;
  flex-shrink: 0;
}
.p-close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--dark-card);
  display: flex;
  align-items: center;
  justify-content: center;
}
.p-voice {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--dark-card);
  display: flex;
  align-items: center;
  justify-content: center;
}
.p-voice:active {
  opacity: 0.7;
}
.voice-icon {
  font-size: 32rpx;
}
.close-x {
  font-size: 32rpx;
  color: var(--dark-txt);
}
.p-nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

/* 进度条 */
.p-progress {
  padding: 16rpx 48rpx 28rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.p-ex-name {
  font-size: 24rpx;
  color: #7A9E8E;
}
.p-set-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.p-set-lbl {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
}
.p-dots {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.p-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #3D524A;
  border: 3rpx solid #5A7A6E;
}
.p-dot-active {
  background: #8BAF9A;
  border-color: #8BAF9A;
}
.p-track {
  width: 100%;
  height: 16rpx;
  background: #3D524A;
  border-radius: 8rpx;
  overflow: hidden;
}
.p-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 8rpx;
  transition: width 0.8s ease;
}

/* 主区域 */
.p-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 44rpx;
  padding: 0 48rpx;
}

.cue-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #9EC4B2;
  text-align: center;
  line-height: 1.3;
  letter-spacing: 1rpx;
}
.cue-text.rest {
  color: var(--dark-muted);
  font-size: 44rpx;
}

/* 圆环计时器 */
.timer-wrap {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  flex-shrink: 0;
}
.timer-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}
.ring-bg {
  fill: var(--dark-surface);
}
.ring-track {
  fill: none;
  stroke: var(--dark-card);
  stroke-width: 10;
}
.ring-progress {
  fill: none;
  stroke: var(--primary);
  stroke-width: 10;
  stroke-linecap: round;
  stroke-dasharray: 553;
  stroke-dashoffset: 0;
  transition: stroke-dashoffset 0.3s linear;
}
.ring-progress.rest {
  stroke: var(--dark-muted);
}
.timer-num {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 144rpx;
  font-weight: 700;
  color: #E8F2EC;
  line-height: 1;
}

.phase-chip {
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  background: var(--dark-card);
  font-size: 28rpx;
  color: var(--dark-txt);
}
.next-cue-txt {
  font-size: 26rpx;
  color: var(--dark-muted);
  text-align: center;
}

/* 控制栏 */
.ctrl-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 80rpx;
  padding: 32rpx 80rpx 80rpx;
  flex-shrink: 0;
}
.ctrl-sm {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--dark-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.ctrl-sm:active {
  opacity: 0.7;
}
.ctrl-icon {
  font-size: 32rpx;
  color: var(--dark-txt);
}
.ctrl-label {
  font-size: 20rpx;
  color: var(--dark-muted);
}
.ctrl-lg {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 40rpx rgba(139, 175, 154, 0.4);
}
.ctrl-lg:active {
  transform: scale(0.93);
}
.ctrl-lg-icon {
  font-size: 36rpx;
  color: #fff;
}

/* 退出确认弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal-box {
  width: 560rpx;
  background: var(--card);
  border-radius: 32rpx;
  padding: 56rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--txt-1);
  margin-bottom: 16rpx;
}
.modal-body {
  font-size: 26rpx;
  color: var(--txt-2);
  margin-bottom: 48rpx;
}
.modal-btns {
  display: flex;
  gap: 24rpx;
  width: 100%;
}
.modal-btn-cancel {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--txt-1);
}
.modal-btn-ok {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: #E74C3C;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
}

.hint-text {
  font-size: 24rpx;
  color: #5A7A6E;
  text-align: center;
}
.ctrl-label {
  font-size: 22rpx;
  color: #5A7A6E;
  margin-top: 4rpx;
}
/* Skip sheet */
.skip-sheet {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff; border-radius: 48rpx 48rpx 0 0;
  padding: 16rpx 40rpx 80rpx;
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
}
.skip-handle { width: 80rpx; height: 8rpx; border-radius: 4rpx; background: #EDE8E4; margin-bottom: 8rpx; }
.skip-title { font-size: 36rpx; font-weight: 700; color: #3D3530; text-align: center; }
.skip-sub { font-size: 26rpx; color: #8C7E77; text-align: center; }
.skip-btns { display: flex; flex-direction: row; gap: 20rpx; width: 100%; margin-top: 8rpx; }
.skip-btn-cancel {
  flex: 1; height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: 44rpx; background: #F0EDE9; color: #3D3530; font-size: 28rpx; font-weight: 600;
}
.skip-btn-ok {
  flex: 1; height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: 44rpx; background: #8BAF9A; color: #fff; font-size: 28rpx; font-weight: 600;
}

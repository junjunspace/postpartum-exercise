/* pages/detail/detail.wxss */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

/* 顶部图区 */
.ex-img {
  background: #2A3530;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ex-gif {
  width: 400rpx;
  height: 400rpx;
}
.ex-img-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ex-img-icon {
  font-size: 72rpx;
}

.screen-body {
  flex: 1;
  height: 0;
  min-height: 0;
}

/* 基本信息 */
.detail-info {
  background: var(--card);
  padding: 36rpx 40rpx 28rpx;
}
.detail-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--txt-1);
  margin-bottom: 20rpx;
  display: block;
}
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.detail-purpose {
  font-size: 26rpx;
  color: var(--txt-2);
  line-height: 1.65;
  display: block;
}

/* 步骤 */
.steps-sec {
  background: var(--bg);
  padding: 32rpx 40rpx 24rpx;
}
.steps-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--txt-1);
  margin-bottom: 24rpx;
  display: block;
}
.step-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 20rpx;
}
.step-num {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}
.step-txt {
  font-size: 26rpx;
  color: var(--txt-1);
  line-height: 1.65;
  padding-top: 6rpx;
  flex: 1;
}

/* 注意事项 */
.notes-sec {
  background: var(--warn-bg);
  padding: 32rpx 40rpx;
}
.notes-hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.notes-icon {
  font-size: 28rpx;
}
.notes-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--warn);
}
.note-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 16rpx;
}
.note-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--warn);
  flex-shrink: 0;
  margin-top: 14rpx;
}
.note-txt {
  font-size: 26rpx;
  color: var(--txt-2);
  line-height: 1.65;
  flex: 1;
}

.spacer {
  height: 160rpx;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 40rpx 56rpx;
  background: var(--card);
  border-top: 2rpx solid var(--border);
  z-index: 10;
}

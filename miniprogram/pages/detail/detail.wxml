<!--pages/detail/detail.wxml - 动作详情-->
<view class="container" wx:if="{{ex}}">
  <view class="ex-img">
    <image wx:if="{{ex.gif}}" class="ex-gif" src="{{ex.gif}}" mode="aspectFit" autoplay></image>
    <view wx:else class="ex-img-circle">
      <text class="ex-img-icon">{{ex.icon}}</text>
    </view>
  </view>

  <scroll-view class="screen-body" scroll-y>
    <view class="detail-info">
      <text class="detail-name">{{ex.name}}</text>
      <view class="detail-tags">
        <text class="tag {{item.cls}}" wx:for="{{ex.tags}}" wx:key="label">{{item.label}}</text>
      </view>
      <text class="detail-purpose">{{ex.purpose}}</text>
    </view>

    <view class="steps-sec">
      <text class="steps-title">动作步骤</text>
      <view class="step-item" wx:for="{{ex.steps}}" wx:key="index">
        <view class="step-num">{{index + 1}}</view>
        <text class="step-txt">{{item}}</text>
      </view>
    </view>

    <view class="notes-sec">
      <view class="notes-hd">
        <text class="notes-icon">⚠️</text>
        <text class="notes-title">注意事项</text>
      </view>
      <view class="note-item" wx:for="{{ex.notes}}" wx:key="index">
        <view class="note-dot"></view>
        <text class="note-txt">{{item}}</text>
      </view>
    </view>

    <view class="spacer"></view>
  </scroll-view>

  <view class="bottom-bar">
    <view class="btn-primary" bindtap="startPractice">
      <text>{{ex.mode === 'guide' ? '▶  开始查看动作指导' : '▶  开始跟练此动作'}}</text>
    </view>
  </view>
</view>

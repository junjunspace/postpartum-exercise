<!--pages/stage/stage.wxml - 阶段详情 · 动作列表-->
<view class="container" wx:if="{{phase}}">
  <view class="stage-banner">
    <text class="banner-title">{{bannerTitle}}</text>
    <text class="banner-sub">{{bannerSub}}</text>
  </view>

  <scroll-view class="screen-body" scroll-y>
    <view class="goal-card">
      <text class="goal-title">本阶段运动目标</text>
      <view class="goal-list">
        <view class="goal-item" wx:for="{{phase.goals}}" wx:key="index">
          <view class="goal-dot"></view>
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view class="section-hd">
      <text class="section-title">本阶段动作</text>
      <text class="section-count">共 {{exercises.length}} 个动作</text>
    </view>
    <view class="ex-list">
      <view class="ex-item {{item.locked ? 'ex-locked' : ''}}" wx:for="{{exercises}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="ex-icon">
          <text class="ex-icon-text">{{item.icon}}</text>
        </view>
        <view class="ex-info">
          <view class="ex-name-row">
            <text class="ex-name">{{item.name}}</text>
            <text wx:if="{{item.mode === 'guide'}}" class="ex-guide-badge">📋 指导</text>
          </view>
          <text class="ex-freq">{{item.freq}}</text>
        </view>
        <text class="ex-chevron">›</text>
      </view>
    </view>
    <view class="spacer"></view>
  </scroll-view>

  <view class="bottom-bar">
    <view class="btn-primary" bindtap="startFull">
      <text>▶  开始全套跟练</text>
    </view>
  </view>
</view>

/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: var(--bg);
}

.home-header {
  padding: 40rpx 48rpx 32rpx;
}
.home-greeting {
  font-size: 26rpx;
  color: var(--txt-2);
  margin-bottom: 12rpx;
  display: block;
}
.home-title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--txt-1);
  line-height: 1.2;
  display: block;
}
.home-sub {
  font-size: 26rpx;
  color: var(--txt-2);
  margin-top: 12rpx;
  display: block;
}

.screen-body {
  flex: 1;
  height: calc(100vh - 200rpx);
}

.stage-list {
  padding: 16rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* 第一阶段卡片 */
.s-card-on {
  border-radius: var(--r-lg);
  padding: 40rpx;
  background: linear-gradient(135deg, #7EA894 0%, #9EC4B0 100%);
  display: flex;
  align-items: center;
  gap: 32rpx;
  min-height: 280rpx;
}
.s-card-on:active {
  opacity: 0.9;
}
.s-card-left {
  flex: 1;
}
.s-badge {
  display: inline-flex;
  padding: 10rpx 24rpx;
  border-radius: var(--r-full);
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 14rpx;
}
.s-badge-on {
  background: rgba(255, 255, 255, 0.25);
}
.s-period {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
  display: block;
}
.s-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}
.s-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.tag-white {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: var(--r-full);
  font-size: 24rpx;
  font-weight: 600;
}
.s-arrow {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}
.arrow-text {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
}

/* 锁定阶段卡片 */
.s-card-off {
  border-radius: var(--r-lg);
  padding: 40rpx;
  background: var(--card);
  border: 3rpx solid var(--border);
  display: flex;
  align-items: center;
  gap: 32rpx;
  min-height: 240rpx;
  opacity: 0.75;
}
.s-card-off:active {
  opacity: 0.55;
}
.s-badge-off {
  background: #F0EDE9;
  color: var(--txt-2);
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: var(--r-full);
  display: inline-flex;
  margin-bottom: 12rpx;
}
.s-period-off {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--txt-3);
  margin-bottom: 8rpx;
  display: block;
}
.s-sub-off {
  font-size: 26rpx;
  color: #C8C0BC;
  display: block;
}
.s-lock {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F5F2EF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lock-text {
  font-size: 32rpx;
}

.s-date-hint {
  font-size: 11px;
  color: rgba(255,255,255,0.7);
  margin-top: 2rpx;
}

/* --- Disclaimer & Delivery Modals --- */
.disclaimer-box { padding: 32rpx 28rpx; }
.modal-icon { font-size: 40rpx; text-align: center; display: block; margin-bottom: 12rpx; }
.warn-strip {
  display: flex; flex-direction: row; align-items: center; gap: 10rpx;
  background: #FFF0E0; border: 1rpx solid #F0C4A0;
  border-radius: 12rpx; padding: 18rpx 24rpx; margin: 12rpx 0;
}
.warn-icon { font-size: 24rpx; flex-shrink: 0; }
.warn-text { font-size: 26rpx; font-weight: 600; color: #8C4A20; flex: 1; }
.cond-list { width: 100%; margin: 4rpx 0 20rpx; }
.cond-item { display: flex; flex-direction: row; align-items: flex-start; gap: 10rpx; padding: 8rpx 0; }
.cond-dot { color: #D4875A; font-size: 28rpx; line-height: 1; }
.cond-item text:last-child { font-size: 26rpx; color: #3D3530; line-height: 1.6; flex: 1; }
.disclaimer-btn {
  background: #8BAF9A; color: #fff; font-size: 28rpx; font-weight: 700;
  border-radius: 54rpx; height: 88rpx; line-height: 88rpx; text-align: center; width: 100%;
}
.delivery-box { padding: 36rpx 28rpx; }
.modal-sub { font-size: 24rpx; color: #8C7E77; text-align: center; display: block; margin-bottom: 32rpx; }
.delivery-row { display: flex; flex-direction: row; gap: 20rpx; width: 100%; margin-bottom: 24rpx; }
.delivery-btn {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 12rpx; padding: 36rpx 0; border-radius: 24rpx;
  background: #fff; border: 2rpx solid #EDE8E4;
}
.delivery-btn.active { border-color: #8BAF9A; background: #F4FAF7; }
.delivery-icon { font-size: 48rpx; }
.delivery-name { font-size: 32rpx; font-weight: 700; color: #3D3530; }
.delivery-desc { font-size: 22rpx; color: #8C7E77; }
.delivery-note { font-size: 22rpx; color: #8C7E77; line-height: 1.6; text-align: center; display: block; }

/* modal-mask & modal-box (used by disclaimer/delivery) */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal-box {
  width: 560rpx;
  background: var(--card);
  border-radius: 32rpx;
  padding: 56rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--txt-1);
  margin-bottom: 16rpx;
  display: block;
  text-align: center;
}

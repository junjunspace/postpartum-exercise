          { "cue": "呼气，轻轻内收肚脐", "phase": "内收", "dur": 6 },
          { "cue": "保持内收，正常呼吸", "phase": "维持 10秒", "dur": 10, "hint": "保持自然呼吸，不要憋气" },
          { "cue": "放松", "phase": "放松 3秒", "dur": 3 }
